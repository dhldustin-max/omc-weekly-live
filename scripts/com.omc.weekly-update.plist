<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OMC weekly Verona + Hanshin auto-scrape — launchd job.
  (Toast 3 stores are handled by the Cowork scheduled task, not here.)

  Runs every 2 hours (and once at load), NOT on a weekly calendar trigger.

  Why: a Monday-07:30-local trigger broke twice. (1) launchd fires the
  instant the Mac wakes, which is before Wi-Fi reassociates –– 08-31-2026
  and 09-06-2026 both died with ERR_INTERNET_DISCONNECTED and were never
  retried until the following week. (2) "Monday 07:30 local" is Sunday
  afternoon in California when Dustin is in Korea, so the California week
  is not over yet and the run is wasted.

  weekly-update.js resolves the target week in America/Los_Angeles and
  self-debounces: once every live Verona store has a value for that week it
  exits immediately without launching Playwright, so the 2-hourly cadence
  is cheap. A missed or half-finished week is picked up on the next tick
  instead of waiting seven days.

  Install:    bash scripts/install-launchd.sh
  Uninstall:  bash scripts/install-launchd.sh ––uninstall
  Manual run: launchctl start com.omc.weekly-update

  Logs:  ~/Library/Logs/omc-weekly-update.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omc.weekly-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/dong/Documents/omc-weekly-live/scripts/weekly-update.js</string>
        <string>--include-verona</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dong/Documents/omc-weekly-live</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/dong</string>
    </dict>

    <!-- Every 2 hours. The script no-ops once the week is complete. -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>StandardOutPath</key>
    <string>/Users/dong/Library/Logs/omc-weekly-update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dong/Library/Logs/omc-weekly-update.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
